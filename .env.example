# ============================================================
# solar-aggregator — Environment Variables
# Copy this file to .env and fill in your real values.
# NEVER commit .env to version control.
# ============================================================

# ----------------------------------------------------------
# RENAC Power
# Verified base URL: https://asia.renacpower.com:8084
# Token is obtained automatically at runtime — do NOT store it here.
# ----------------------------------------------------------
RENAC_BASE_URL=https://asia.renacpower.com:8084
RENAC_EMAIL=your_renac_email@example.com
RENAC_PASSWORD=your_renac_password_here
RENAC_STATION_ID=149199

# ----------------------------------------------------------
# ShineMonitor (Eybond SmartClient)
# Verified base URL: https://web.shinemonitor.com/public/
# Token and secret are obtained automatically at runtime — do NOT store them here.
# ----------------------------------------------------------
SHINEMONITOR_BASE_URL=https://web.shinemonitor.com/public/
SHINEMONITOR_USERNAME=your_shinemonitor_username@example.com
SHINEMONITOR_PASSWORD=your_shinemonitor_password_here
SHINEMONITOR_COMPANY_KEY=bnrl_frRFjEz8Mkn
SHINEMONITOR_PLANT_ID=1301951

# ----------------------------------------------------------
# Global HTTP / Runtime Settings
# ----------------------------------------------------------
# HTTP request timeout in seconds
HTTP_TIMEOUT=15
# Max retries for transient failures
HTTP_MAX_RETRIES=3
# Log level: TRACE | DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO
# Polling interval in minutes (used by main.py scheduler)
POLL_INTERVAL_MINUTES=15
# Timezone for display/logging (IANA format, e.g. Asia/Kolkata, UTC, Europe/Berlin)
TIMEZONE=UTC

# ----------------------------------------------------------
# Notifications — Email (SMTP)
# Leave SMTP_HOST blank to disable email notifications.
# ----------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_TO=

# ----------------------------------------------------------
# Notifications — Telegram
# Leave TELEGRAM_BOT_TOKEN blank to disable Telegram notifications.
# ----------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ----------------------------------------------------------
# Notifications — Discord
# Leave DISCORD_WEBHOOK_URL blank to disable Discord notifications.
# ----------------------------------------------------------
DISCORD_WEBHOOK_URL=
