{
  "version": 2,
  "builds": [
    {
      "src": "api/**/*.py",
      "use": "@vercel/python",
      "config": {
        "includeFiles": "src/**"
      }
    },
    {
      "src": "public/**/*",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/$1.py"
    },
    {
      "src": "/login\\.html",
      "status": 301,
      "headers": { "Location": "/login" }
    },
    {
      "src": "/settings\\.html",
      "status": 301,
      "headers": { "Location": "/settings" }
    },
    {
      "src": "/index\\.html",
      "status": 301,
      "headers": { "Location": "/" }
    },
    {
      "src": "/login",
      "dest": "/public/login.html"
    },
    {
      "src": "/settings",
      "dest": "/public/settings.html"
    },
    {
      "src": "/",
      "dest": "/public/index.html"
    },
    {
      "src": "/(.*\\.(?:css|js|png|jpg|ico|svg))",
      "dest": "/public/$1"
    }
  ],
  "crons": [
    {
      "path": "/api/cron",
      "schedule": "30 14 * * *"
    }
  ]
}